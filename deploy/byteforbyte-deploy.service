[Unit]
Description=Receive verified Byte for Byte builds from GitHub Actions
After=network-online.target

[Service]
User=byteforbyte-deploy
Group=byteforbyte-deploy
ExecStart=/usr/bin/python3 /usr/local/libexec/byteforbyte-deploy.py
Restart=on-failure
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
# A single mount lets the receiver rename from staging to public atomically.
ReadWritePaths=/srv/byteforbyte

[Install]
WantedBy=multi-user.target
