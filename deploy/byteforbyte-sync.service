[Unit]
Description=Install the verified byteforbyte catalog from GitHub
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=byteforbyte-deploy
Group=byteforbyte-deploy
ExecStart=/usr/local/libexec/byteforbyte-sync
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/byteforbyte/public /srv/byteforbyte/staging
